# Print Explosion 3D settings. Only ANTHROPIC_API_KEY is required.

# --- AI ---
# Required. The only secret the app needs.
ANTHROPIC_API_KEY=
# AI provider adapter (see src/.../ai/).
PE_PROVIDER=anthropic
# Model used for the designer chat.
PE_MODEL=claude-sonnet-5-5
# Thinking effort: low | medium | high | xhigh | max.
PE_EFFORT=medium
# Automatic AI retries when a design fails to build.
PE_MAX_AUTO_FIXES=2
# Show a running cost estimate in the status bar.
PE_SHOW_COST=false

# --- Files ---
# Projects. Empty = ~/Documents/Print Explosion 3D
PE_WORKSPACE_DIR=
# OpenSCAD binary. Empty = PATH, then /Applications.
OPENSCAD_BIN=
# Seconds before a build is given up (5 to 600).
PE_RENDER_TIMEOUT=120

# --- App ---
# Check for a new version on start.
PE_UPDATE_CHECK=true

# --- Theme ---
# Viewer model color (#rrggbb).
PE_MODEL_COLOR=#f2a65a
# Viewer background color (#rrggbb).
PE_BG_COLOR=#f7f3ee
# Ground shadow darkness, 0 to 1.
PE_SHADOW_OPACITY=0.18
# Idle spin speed in radians per second.
PE_SPIN_SPEED=0.35
